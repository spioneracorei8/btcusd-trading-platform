# The stack itself. Enabled so a reboot brings everything back with no manual
# step — that is a checklist item in deploy/README.md §8, and the reason this
# is a unit rather than a line in someone's shell history.
#
# The containers carry `restart: unless-stopped`, so Docker restarts an
# individual service that dies. This unit exists for the other case: the whole
# host coming back up.

[Unit]
Description=BTC/USDT collector stack (docker compose)
Documentation=file:/opt/btcusd/deploy/README.md
Requires=docker.service
After=docker.service network-online.target tailscaled.service
Wants=network-online.target tailscaled.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/btcusd

# There is no wait for tailscale0 here any more.
#
# There used to be: the api published on the Tailscale address, so Docker
# failed with "cannot assign requested address" if the interface had no address
# yet, and the stack stayed down until somebody noticed. Since phase 09b the
# api publishes on loopback only and `tailscale serve` puts it on the tailnet,
# so nothing in this stack needs that address to exist.
#
# That is the better arrangement anyway: collecting candles no longer depends
# on the tailnet being healthy. A host that boots with Tailscale broken still
# records the market and is simply unreachable until it is fixed.

ExecStart=/opt/btcusd/deploy/compose.sh up -d --remove-orphans
ExecStop=/opt/btcusd/deploy/compose.sh down

# Pulling and building images on a 2 vCPU box is not quick, and a timeout part
# way through a build leaves a half-built stack.
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
