# The stack itself. Enabled so a reboot brings everything back with no manual
# step — that is a checklist item in deploy/README.md §8, and the reason this
# is a unit rather than a line in someone's shell history.
#
# The containers carry `restart: unless-stopped`, so Docker restarts an
# individual service that dies. This unit exists for the other case: the whole
# host coming back up.

[Unit]
Description=BTC/USDT collector stack (docker compose)
Documentation=file:/opt/btcusd/deploy/README.md
Requires=docker.service
After=docker.service network-online.target tailscaled.service
Wants=network-online.target tailscaled.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/btcusd

# The api publishes on the Tailscale address. If that address is not on the
# interface yet, Docker fails with "cannot assign requested address" and the
# stack stays down until somebody notices — which on a reboot at 3am means
# hours of missing candles. tailscaled being *started* is not the same as the
# interface having an address, so this waits for the address itself.
ExecStartPre=/usr/bin/env bash -c 'for i in $(seq 1 30); do ip -4 addr show tailscale0 2>/dev/null | grep -q "inet " && exit 0; sleep 2; done; echo "tailscale0 still has no IPv4 address after 60s" >&2; exit 1'

ExecStart=/usr/bin/docker compose --env-file /opt/btcusd/.env \
    -f /opt/btcusd/deploy/docker-compose.yml \
    -f /opt/btcusd/deploy/docker-compose.prod.yml \
    up -d --remove-orphans

ExecStop=/usr/bin/docker compose --env-file /opt/btcusd/.env \
    -f /opt/btcusd/deploy/docker-compose.yml \
    -f /opt/btcusd/deploy/docker-compose.prod.yml \
    down

# Pulling and building images on a 2 vCPU box is not quick, and a timeout part
# way through a build leaves a half-built stack.
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
