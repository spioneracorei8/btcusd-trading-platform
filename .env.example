# Copy to .env and adjust. .env is git-ignored and must never be committed.
#
# Every variable the server reads is listed here. The four under "required"
# have no default: a process that cannot see them refuses to start and names
# the ones that are missing.
#
# ---------------------------------------------------------------------------
# This file is the only source of configuration, and compose is given it
# explicitly
# ---------------------------------------------------------------------------
#
# Compose looks for `.env` in the directory holding the compose file —
# `deploy/` — not here. There is no `deploy/.env`, so a compose command without
# `--env-file` reads no environment file at all. Every Makefile target passes
# this one by absolute path, and so does the systemd unit on the VPS.
#
# The compose file no longer carries defaults for anything that decides what
# the system collects or what its numbers mean. Those are marked REQUIRED
# below, and compose refuses to start without them rather than substituting
# something plausible. A default that looks reasonable but is not what you
# chose is worse than no default: the stack comes up healthy and the mistake
# is invisible.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# dev or prod. Also selects the log handler: text in dev, JSON in prod.
# REQUIRED by compose.
APP_ENV=dev

# debug, info, warn or error.
LOG_LEVEL=debug

# Port the API server listens on.
HTTP_PORT=8080

# Connection string used from the HOST, e.g. by `make migrate-up`.
# Inside docker compose the api and collector services get their own
# DATABASE_URL pointing at the `postgres` service instead of localhost.
DATABASE_URL=postgres://trading:trading@localhost:5432/btcusd?sslmode=disable

# ---------------------------------------------------------------------------
# Market (optional, defaults shown)
# ---------------------------------------------------------------------------

# The single instrument this deployment analyses.
# REQUIRED by compose.
MARKET_SYMBOL=BTCUSDT

# spot or futures. Futures behaviour is not implemented yet; the setting
# exists so no endpoint or symbol format gets hardcoded in calculation code.
# REQUIRED by compose.
MARKET_TYPE=spot

# Comma separated. 1m and 5m drive the scalping strategies, 15m and 1h are
# used as trend filters.
# REQUIRED by compose.
MARKET_TIMEFRAMES=1m,5m,15m,1h,4h,1d

# Taker fee in percent (0.05 means 0.05%). Trading costs are configuration,
# never constants in code: every backtest result is reported net of them.
# REQUIRED by compose.
FEE_TAKER_PCT=0.05

# What a resting (limit) order pays instead, charged only when it fills.
#
# This is the largest single lever on this system's economics: a round trip at
# maker rates costs 0.04% against 0.1% at taker rates. It buys nothing on its
# own — a limit order only fills if price comes to it, and the runs that never
# filled are reported as cancelled signals.
FEE_MAKER_PCT=0.02

# market or limit, per side.
#
# Defaults reproduce every completed evaluation. The realistic configuration is
# asymmetric — a limit entry can wait, a stop cannot — which is why the two are
# separate. Under ENTRY_ORDER_TYPE=limit the entry rests at the signal bar's
# close; under EXIT_ORDER_TYPE=limit only *targets* rest, because a stop that
# only filled at its price would not fill when the market gaps through it.
ENTRY_ORDER_TYPE=market
EXIT_ORDER_TYPE=market

# How many bars an unfilled limit order rests before it is cancelled and the
# trade never happens. Watch the cancelled-order rate in the report: a strategy
# that turns positive only because most of its signals never filled has been
# sampled, not improved.
LIMIT_ORDER_TIMEOUT_BARS=1

# Assumed slippage of a fill, in price ticks.
# REQUIRED by compose.
SLIPPAGE_TICKS=1

# What one tick is worth, in quote currency — 0.01 is the BTCUSDT spot tick.
# Without it SLIPPAGE_TICKS is a count with no unit. Must be positive: to
# simulate without slippage set SLIPPAGE_TICKS=0, which is visible in the
# backtest report header, rather than nulling the unit it is measured in.
# REQUIRED by compose.
MARKET_TICK_SIZE=0.01

# ---------------------------------------------------------------------------
# Venue cost model (optional, defaults shown)
# ---------------------------------------------------------------------------
#
# percentage | spread. See docs/decisions/0021-spread-cost-model.md.
#
# percentage charges FEE_TAKER_PCT/FEE_MAKER_PCT as a share of notional, which
# is what an exchange does and what every evaluation up to phase 06 used. It
# stays the default so those results remain comparable.
#
# spread charges the bid/ask distance in price points, which is what a CFD
# venue does. The difference is not a reparameterisation: on an exchange the
# cost of a round trip scales with the price level, and on a spread venue it
# does not. At 1m — where a bar's range and the spread are the same order of
# magnitude — the wrong one misprices every trade, in opposite directions
# depending on where price happens to be.
#
# Everything below applies only under COST_MODEL=spread. The defaults describe
# an IUX Standard account trading BTCUSD as a CFD.
COST_MODEL=percentage

# Typical quoted spread, in points. 2500 points at 0.01 of price is 25.00,
# which at the 0.01 lot minimum is 0.25 across a round trip — against 0.63 for
# the same size on Binance at 63,000.
#
# "Typical" is doing real work here: the spread floats, and it widens exactly
# when a strategy most wants to trade. The backtest's --cost-sweep scales this
# the same way it scales fees, and a 2x pass is a news release rather than
# pessimism.
SPREAD_POINTS=2500

# What one point of that spread is worth in price. Spread cost is
# SPREAD_POINTS x POINT_VALUE of price, charged half on each side of a round
# trip, so the total given up is one full spread and not two.
POINT_VALUE=0.01

# Units per lot, and the grid position sizes must land on. 1 lot = 1 BTC,
# minimum 0.01, in 0.01 steps.
#
# A computed size is rounded *down* onto that grid, and one that falls below
# MIN_LOT is refused rather than taken at the minimum: taking it anyway is a
# larger bet than the strategy asked for, and on a small balance "a bit larger"
# can be several times the intended risk. The refusals are counted and reported
# — with a 100 USD account they may be most of the signals, which is a fact
# about the account rather than about the strategy.
CONTRACT_SIZE=1
MIN_LOT=0.01
LOT_STEP=0.01

# Charged per lot per side, on top of the spread. Zero on a Standard account,
# where the cost is entirely in the spread; a Raw account would be 4.
COMMISSION_PER_LOT=0

# ---------------------------------------------------------------------------
# Account leverage
# ---------------------------------------------------------------------------

# How much notional the account may hold per unit of equity. Unlike everything
# above, this applies under BOTH cost models.
#
# One is a cash account: a position may be no larger than the balance can pay
# for outright. That is the right model for spot and it is what every
# evaluation before the CFD venue assumed, so it stays the default — an
# unstated leverage must never silently make positions larger.
#
# It is not a cosmetic setting. On a 100 USD balance at BTC 27,000 a cash
# account can hold 0.0037 BTC, which is below the 0.01 lot minimum, so *every*
# entry is refused — and because the cap binds before the risk arithmetic
# matters, 1% risk and 20% risk produce identical runs. The backtest report
# says "capped first" on the skipped-for-size line when that is happening.
#
# Set it to what the venue actually offers. A CFD account trading 0.01 lot of
# BTC at 27,000 is holding 270 USD of notional against a 100 USD balance —
# 2.7x, and ordinary there.
#
# Raising it does not make a strategy safer. It removes a constraint that was
# masking the risk setting; --risk-pct is then what decides position size, and
# the report's "risk per trade" lines are what to read.
MAX_LEVERAGE=1

# ---------------------------------------------------------------------------
# Market data ingestion (optional, defaults shown)
# ---------------------------------------------------------------------------

# Binance public market-data endpoints. Configuration rather than constants so
# the futures endpoints can be swapped in later without touching call sites.
# No API key is used anywhere in this system and none with trading rights may
# ever be introduced — public market data needs none.
BINANCE_REST_BASE_URL=https://api.binance.com
BINANCE_WS_BASE_URL=wss://stream.binance.com:9443

# How far back history is collected (RFC3339, UTC).
#
# It is honoured in both directions. The collector walks forward from the
# newest stored candle, and before that it checks whether the series begins
# later than this and fills the difference. Moving this date earlier therefore
# does collect the older history, on the next start — which was not true before
# phase 06: the forward walk alone could never reach behind whatever was
# collected first, so an edited date changed nothing and said nothing.
#
# Six months before the development set (2023-01-01) rather than at it, and the
# gap is the warm-up budget. A trend contributor says nothing until it has seen
# WarmupMultiplier x EMAPeriod closes — 1000 of them — and a 4h contributor
# needs about 167 days of runway before the development set opens. Set this to
# the development-set boundary and every higher-timeframe filter is cold for
# the whole evaluation, reporting zero trades and no reason.
#
# 1d would need 1000 daily closes, about 2.7 years. It is not a contributor
# anywhere for that reason (ADR 0018); backfilling to 2020 is what would let it
# come back.
# REQUIRED by compose.
MARKET_BACKFILL_FROM=2022-07-01T00:00:00Z

# How often the candle series is scanned for holes. Between 1m and 24h.
MARKET_GAPCHECK_INTERVAL=15m

# How often the collector writes its status row. The api reads that row to
# answer /internal/market/status: the two run in separate containers and
# cannot share memory. Between 1s and 1m.
COLLECTOR_HEARTBEAT_INTERVAL=5s

# ---------------------------------------------------------------------------
# Database pool (optional, defaults shown)
# ---------------------------------------------------------------------------

DATABASE_MAX_CONNS=10

# ---------------------------------------------------------------------------
# Live strategy evaluation (optional; unset means the collector only collects)
# ---------------------------------------------------------------------------

# The registered strategy to run against the live stream; run
# `make backtest ARGS=--list-strategies` for the names. Leave it empty and the
# collector does what it did before phase 07 — collects candles, evaluates
# nothing.
#
# Empty is the default deliberately. Starting to evaluate a strategy live
# should be a decision somebody made, not something that happened because a
# deploy went out.
#
# No strategy has met the acceptance criteria (docs/experiments.md), so
# whatever is set here is a placeholder for exercising the pipeline, not a
# recommendation. The best available is ema_crossover on 4h with defaults.
# STRATEGY_NAME=ema_crossover

# The timeframe it decides on. It must be one of MARKET_TIMEFRAMES, or the
# candles it needs are not being collected and the collector refuses to start
# rather than evaluating a series that will never arrive.
STRATEGY_TIMEFRAME=4h

# Parameter overrides, in the same name=value form --param takes on the
# backtest CLI, comma-separated. `make backtest ARGS=--list-strategies` prints
# every name with its default and its neighbourhood step.
#
# One mechanism and one set of names for live and backtest, because the
# comparison in phase 07 part B is only meaningful between runs configured
# identically. A name that does not exist is an error at start-up, not a
# silently ignored line.
# STRATEGY_PARAMS=fast=12,slow=26

# The trend filter to gate signals with. Not yet implemented for the live
# path: a value here is refused at start-up rather than ignored, because a
# filtered backtest compared against unfiltered live signals would report a
# divergence that is an artefact of the configuration and nothing else.
STRATEGY_TREND_FILTER=

# ---------------------------------------------------------------------------
# Outcome tracking
# ---------------------------------------------------------------------------
# This runs whether or not a strategy is configured. The follower reads
# signals out of the table, not out of the evaluator, so a strategy that has
# just been switched off still has its outstanding signals resolved — and
# those are exactly the ones worth knowing about.

# How many bars a signal is followed before it is recorded as expired.
#
# A measurement window, not a trading rule: nothing here opens or closes
# anything. Forty-eight bars is eight hours on 10m and eight days on 4h — long
# enough that a trade with room to work is not cut off by the clock, short
# enough that a signal nobody could still act on stops counting as live.
#
# Expired is a real outcome and it counts. A strategy whose signals mostly
# expire is a strategy that mostly does nothing, and dropping those rows would
# leave a win rate computed over only the trades that went somewhere.
SIGNAL_EXPIRY_BARS=48

# How often open signals are advanced against newly stored candles. Between
# 1s and 1h.
OUTCOME_INTERVAL=1m

# Reading the result:
#
#   make reconcile ARGS="--days 90"
#   GET /internal/signals/reconciliation?days=90
#
# Both print the same report from the same code. It is grouped by strategy,
# version and resolved parameter set, with no total across groups — averaging
# across a parameter change produces a number describing nothing.
#
# Every group carries a NOT ENOUGH DATA banner, and no divergence is reported,
# until it has 100 resolved signals. The banner states how long the rest would
# take at the observed rate. See docs/reading-a-divergence.md.

# ---------------------------------------------------------------------------
# Notifications
# ---------------------------------------------------------------------------

# Whether a recorded signal is also delivered to the owner's phone.
#
#   silent  evaluate, write to signals, send nothing
#   notify  also queue each signal for delivery
#
# There are exactly two and there will not be a third. A name like UAT or TEST
# would imply a behaviour that does not exist: the system can send or not send,
# and whether the owner acts on an alert with demo money or real money is not
# something it knows or should model.
#
# silent is the default deliberately. Beginning to send alerts should be a
# decision somebody made, not something that happened because a deploy went
# out.
#
# NOTIFY_ENABLED used to do this job and is now REJECTED at start-up rather
# than ignored. Two switches for one behaviour means somebody sets this one,
# gets nothing, and looks for the fault in the push service. Delete it from
# your .env.
SIGNAL_MODE=silent

# All three are required when SIGNAL_MODE=notify and unused otherwise. A mode
# that claims to deliver and has nowhere to send looks like it is working,
# which is worse than one that says it will not.
#
# Generate a pair once:
#
#   make vapid-keys >> .env
#
# Rotating the pair invalidates every existing subscription: the browser
# subscribed against the old public key, and the push service refuses a push
# signed by a different one. The phone re-registers on its next launch, so the
# cost is one missed signal rather than a manual step — but it is not free, and
# there is no reason to rotate these on a schedule.

# What the browser subscribes against. NOT a secret: it is served to the app on
# GET /api/v1/device precisely so a rotation does not need an app rebuild.
VAPID_PUBLIC_KEY=

# Signs the JWT that proves a push came from this server.
#
# This IS a secret, and it is the one credential in this file that can push to
# the owner's phone. It is never logged, never quoted in an error, and never
# served. Keep it off any path that ends up in an image layer.
VAPID_PRIVATE_KEY=

# Who to contact about this application server — a mailto: or https: URL,
# required by RFC 8292. Push services use it when something is wrong with the
# traffic, not for delivery, and some reject a push without it with a 403 that
# reads like a key problem.
VAPID_SUBJECT=mailto:you@example.com

# FCM IS GONE. FCM_PROJECT_ID, FCM_CREDENTIALS_FILE and FCM_DEVICE_TOKEN are
# all REJECTED at start-up rather than ignored.
#
# The device is an iPhone and the app is a PWA, which cannot use FCM at all.
# Keeping both transports would leave one exercised by nothing, and an untested
# delivery path is a broken one nobody has noticed. See ADR 0028.
#
# If your .env still carries them: delete all three, and delete the service
# account key from the host. Leaving them would mean a file that reads as
# configured for delivery while naming credentials for a transport that no
# longer exists — and somebody debugging silent alerts would go and check
# Firebase.
#
# The subscription is not something you can set either. The browser issues it
# to the installed app and replaces it whenever it likes — on reinstall, when
# site data is cleared, on expiry. A value here would be last month's from that
# moment on, and nothing would notice: the process starts, the keys validate,
# signals are recorded and queued, and every send is rejected as gone.
#
# The app registers itself:
#
#   POST /api/v1/device   {"endpoint": "https://...", "keys": {"p256dh": "...", "auth": "..."}}
#
# and it lives in the `devices` table. See ADR 0026.
#
# Notify mode starts with nothing registered — it has to, since the phone
# cannot register against a process that refuses to run. Whether a device is
# registered is reported by GET /api/v1/status, which says in words that
# signals are being recorded and not delivered while none is. Alerts queued in
# the meantime wait rather than failing: they deliver as soon as a phone
# registers.
#
# A subscription the push service has expired is rejected permanently rather
# than retried, so the notification is marked failed on the first attempt with
# a reason that says to open the app. Delivery is retried 5 times over about
# 8 minutes for anything that looks transient, and then given up on: a push
# about a scalping signal has a short useful life, and a row still retrying an
# hour later helps nobody while holding the queue behind it.

# ---------------------------------------------------------------------------
# docker compose only
# ---------------------------------------------------------------------------
# These are read by deploy/docker-compose.yml, not by the Go code. The compose
# file has the same defaults built in, so `docker compose up` works without a
# .env file at all. CHANGE THE PASSWORD BEFORE DEPLOYING TO A VPS.

POSTGRES_USER=trading
# REQUIRED by compose. Generate a strong one before any real deployment.
POSTGRES_PASSWORD=trading
POSTGRES_DB=btcusd

# Host port the API is published on (bound to 127.0.0.1).
API_HOST_PORT=8080

# Host port PostgreSQL is published on (bound to 127.0.0.1), so `make
# migrate-up` and integration tests can reach it.
POSTGRES_HOST_PORT=5432

# Host port Adminer is published on (bound to 127.0.0.1). Adminer only runs
# under the `tools` profile — `make adminer` — not on a plain `compose up`.
ADMINER_HOST_PORT=8081

# ---------------------------------------------------------------------------
# VPS deployment only (deploy/docker-compose.prod.yml)
# ---------------------------------------------------------------------------
# Ignored by a development stack. See deploy/README.md.

# TAILSCALE_IP is GONE. Nothing reads it any more.
#
# The api was published on this host's tailnet address as well as on loopback,
# and this variable guarded that mapping. Since phase 09b the api is published
# on loopback only and `tailscale serve` is what puts it on the tailnet — over
# HTTPS, which the app requires and which a published port cannot provide.
#
# The address itself is still worth recording, in deploy/README.md §1, because
# it is painful to reconstruct. It is no longer configuration.

# ---------------------------------------------------------------------------
# WEB APP
# ---------------------------------------------------------------------------

# Where the built web app is, inside the api container.
#
# Unset means the api serves the API alone, which is what a development run and
# every test wants. Set, it must be a directory: the process refuses to start
# otherwise, because a typo here produces a deployment that answers every page
# with 404 and looks like a build that did not happen.
#
# On the VPS this is set by deploy/docker-compose.web.yml, together with
# WEB_ROOT_HOST — the directory `expo export --platform web` wrote.
# WEB_ROOT=/srv/web
# WEB_ROOT_HOST=/srv/btcusd/web

# Browser origins the websocket accepts besides the one it was served from.
#
# Empty in a real deployment. The app and the API share an origin there, so
# same-origin — which the library allows without being told — is the whole
# rule, and the check holds with nothing configured.
#
# It exists for development, where the app is served by Metro on one port and
# the API answers on another. A host listed here may open the signal feed from
# any page it serves, so it is a development tool and not a convenience. "*"
# is refused: it is the check switched off while looking like it is on.
# STREAM_ALLOWED_ORIGINS=http://localhost:8081

# Container engine the Makefile drives: podman or docker. Leave it commented
# to auto-detect (podman when installed, otherwise docker), or pin it here.
#
# It matters because the two keep separate container and volume namespaces:
# pointing a target at the wrong one builds a second, empty stack beside the
# real one instead of failing. `make engine` prints which one is in use.
# CONTAINER_ENGINE=podman

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------
# Set to run the storage integration tests against a real database. When it is
# unset those tests skip, so `go test ./...` passes without Docker.
# TEST_DATABASE_URL=postgres://trading:trading@localhost:5432/btcusd?sslmode=disable
